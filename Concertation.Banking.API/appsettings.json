{
  "ConnectionStrings": {
    "DefaultConnection": "Host=concertation.banking-db;Port=5432;Database=concertationbanking;Username=admin;Password=admin123;",
    "Redis": "redis:6379"
  },
  "Keycloak": {
    "BaseUrl": "http://host.docker.internal:18080",
    "Realm": "concertation-realm",
    "Audience": "account",
    //"AuthClientId": "",
    //"AuthClientSecret": "",
    //"AdminClientId": "",
    //"AdminClientSecret": "",
    "UseHttpsForRedirects": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://concertation-seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
